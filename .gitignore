# Environments — never commit real secrets
.env
.env.*
!.env.template
!.env.example
.venv/
venv/
ENV/
env.bak/
venv.bak/

# Logs
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Frontend/Node
node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Credentials — explicit denies, not a blanket *.json (keeps package-lock.json,
# tsconfig*.json etc. tracked, unlike the private-repo .gitignore this was forked from)
**/service-account*.json
**/*-service-account.json
.mcp.json
.crush.json
*.pem
*.key
!fastapp/services/**/*.key.example

# Scratch backtest run directories (sandbox/backtest_tool.py writes here)
/runs/

# Filled-in GKE secret env file — see deploy/k8s/secret.env.example
deploy/k8s/secret.env
