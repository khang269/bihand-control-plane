# Copy this file to fastapp/.env and fill in the two generated secrets below.
# Everything else already works with the bundled `docker compose` stack.
#
#   cp fastapp/.env.example fastapp/.env
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(96)).decode())"   # -> MONGO_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"                                     # -> JWT_SECRET_KEY

# --- MongoDB (the bundled `mongo` container — no Atlas account needed) ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=bihand

# --- CSFLE master key. Generate once, then NEVER regenerate — every encrypted
# credential (provider keys, OAuth tokens, agent tokens) becomes permanently
# unreadable if you lose or rotate this. See command above.
MONGO_KEY=

# --- Session signing ---
JWT_SECRET_KEY=

# --- First-run admin. Comma-separated emails; log in with the `local` auth
# provider using this address (password is set on first login). ---
ADMIN_USER=admin@localhost

# --- Google Cloud Compute (only required if you provision agents onto real GCP
# VMs — optional for local/dev use of the fleet + M2M control plane) ---
GOOGLE_CLOUD_PROJECT_ID=
GCP_REGION=us-central1
GCP_DEFAULT_ZONE=us-central1-a
GCS_BUCKET_NAME=
GOOGLE_API_KEY=

# --- Trading Studio sandbox (only required to actually run it against a real
# Cloud Run Job — the API/UI still load without this; see Dockerfile.sandbox
# and ARCHITECTURE.md for the terraform this job needs, deployed with a
# zero-IAM-role service account). Leave unset to use the default job name. ---
TRADING_SANDBOX_JOB=bihand-trading-sandbox

# --- Google OAuth login (fully optional). The default sign-in is local
# email/password — GET /api/auth/config only advertises Google once these are
# set, and the frontend only shows the button then. Leave blank to skip it. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501/api/auth/google/callback

# --- Meta (Facebook) — only needed for the outbound social-posting tools ---
META_APP_ID=
META_APP_SECRET=

# --- Misc ---
LOG_LEVEL=INFO
ENV=dev
PORT=8501
REDIS_URL=redis://redis:6379/0
BIHAND_PUBLIC_API_URL=http://localhost:8501
