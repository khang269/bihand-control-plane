# Copy to secret.env (gitignored — never commit real values) and fill in.
# Load it into the cluster with:
#   kubectl create secret generic bihand-secrets -n bihand --from-env-file=secret.env
#
# Generate MONGO_KEY / JWT_SECRET_KEY the same way as local dev — see
# ../../fastapp/.env.example. MONGO_KEY especially: generate it ONCE and
# never rotate it against an existing database, or every stored credential
# becomes permanently unreadable.
MONGODB_URI=
MONGODB_DATABASE=bihand
MONGO_KEY=
JWT_SECRET_KEY=

# First-run admin allowlist (comma-separated emails). See DEPLOYMENT.md.
ADMIN_USER=

# Only needed if you enable Google OAuth login (optional — local email/password
# is the default) or provision real GCP VMs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# Only needed for the outbound social-posting agent tools.
META_APP_ID=
META_APP_SECRET=
