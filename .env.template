# Root .env — auto-loaded by `docker compose` for ${VAR} substitution in
# docker-compose.test.yml (the litellm service's Gemini key). This is separate
# from fastapp/.env.example, which each container loads for its own app config.
#
#   cp .env.template .env   # then fill in GEMINI_API_KEY (free key: aistudio.google.com)
GEMINI_API_KEY=placeholder
LITELLM_MASTER_KEY=sk-local-dev

# MongoDB Configuration
MONGODB_URI=placeholder
MONGODB_DATABASE=placeholder
MONGO_KEY=placeholder

# Admin account
ADMIN_USER=placeholder

# Google crendentials
GOOGLE_CLOUD_PROJECT_ID=placeholder
GCP_REGION=placeholder
GCS_BUCKET_NAME=placeholder
GOOGLE_API_KEY=placeholder
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_REDIRECT_URI=placeholder

# Meta (Facebook) credentials - used for Meta Developer Tools MCP OAuth
META_APP_ID=placeholder
META_APP_SECRET=placeholder

# JWT
JWT_SECRET_KEY=placeholder

# GCP Compute Engine
GCP_DEFAULT_ZONE=placeholder

# Logging
LOG_LEVEL=INFO
ENV=prod
PORT=8501
REDIS_URL=placeholder